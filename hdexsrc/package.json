{
  "name": "DefiShares",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "web": "pnpm --filter @defishares/web dev",
    "web:build": "pnpm --filter @defishares/web build",
    "web:typecheck": "pnpm --filter @defishares/web typecheck",
    "core:test": "pnpm --filter @defishares/core test",
    "core:typecheck": "pnpm --filter @defishares/core typecheck",
    "cross:test": "pnpm --filter @defishares/core exec node --test --import tsx ../../tests/shared-core.test.mjs",
    "testnet:preflight": "pnpm --filter @defishares/core exec tsx ../../scripts/testnet-preflight.ts",
    "verify:web": "pnpm core:test && pnpm core:typecheck && pnpm web:typecheck && pnpm web:build",
    "sync:assets": "cp src/assets/kline.html android/app/src/main/assets/",
    "android": "npm run sync:assets && react-native run-android --mode defiSharesDebug --appId org.defishares.hdexapp",
    "android:clean": "cd android && ./gradlew clean",
    "android:main": "npm run sync:assets && react-native run-android --mode defiSharesDebug --appId org.defishares.hdexapp",
    "android:main:release": "npm run sync:assets && react-native run-android --mode defiSharesRelease --appId org.defishares.hdexapp",
    "android:main:dist": "npm run sync:assets && cd android && ./gradlew assembleDefiSharesRelease",
    "android:dist:all": "npm run sync:assets && cd android && ./gradlew assembleRelease",
    "ios": "react-native run-ios",
    "ios:installdeps": "cd ios && bundle exec pod install",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@defishares/core": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.83.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "@rneui/base": "^4.0.0-rc.8",
    "@rneui/themed": "^4.0.0-rc.8",
    "assert": "^2.1.0",
    "bignumber.js": "^9.3.1",
    "bitsharesjs": "^6.0.3",
    "bitsharesjs-ws": "^6.0.2",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "process": "^0.11.10",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-mmkv": "4.1.0",
    "react-native-nitro-modules": "0.32.0",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "4.25.0",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.16.0",
    "stream-browserify": "^3.0.0",
    "text-encoding": "^0.7.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/codegen": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/gradle-plugin": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
