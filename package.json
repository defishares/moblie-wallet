{
  "name": "@defishares/wallet",
  "version": "1.0.4",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.19.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "mobile:start": "pnpm --filter @defishares/mobile start",
    "mobile:android": "pnpm --filter @defishares/mobile android",
    "mobile:ios": "pnpm --filter @defishares/mobile ios",
    "mobile:ios:installdeps": "pnpm --filter @defishares/mobile ios:installdeps",
    "mobile:build:android": "pnpm --filter @defishares/mobile android:main:dist",
    "mobile:typecheck": "pnpm --filter @defishares/mobile typecheck",
    "mobile:test": "pnpm --filter @defishares/mobile test:unit",
    "mobile:lint": "pnpm --filter @defishares/mobile lint",
    "mobile-web": "pnpm --filter @defishares/mobile-web dev",
    "mobile-web:build": "pnpm --filter @defishares/mobile-web build",
    "mobile-web:preview": "pnpm --filter @defishares/mobile-web preview",
    "mobile-web:typecheck": "pnpm --filter @defishares/mobile-web typecheck",
    "mobile-web:test": "pnpm --filter @defishares/mobile-web test",
    "core:test": "pnpm --filter @defishares/core test",
    "core:typecheck": "pnpm --filter @defishares/core typecheck",
    "cross:test": "node --test --import tsx tests/shared-core.test.mjs",
    "testnet:preflight": "tsx scripts/testnet-preflight.ts",
    "test": "pnpm core:test && pnpm mobile-web:test && pnpm mobile:test && pnpm cross:test",
    "verify:mobile-web": "pnpm core:typecheck && pnpm mobile-web:typecheck && pnpm mobile-web:build"
  },
  "devDependencies": {
    "@defishares/core": "workspace:*",
    "tsx": "^4.20.6"
  }
}
